* text=auto eol=lf
*.slx -text
*.mdl -text
*.mat -text
*.pdf -text
*.zip -text
*.png -text
*.jpg -text
*.xlsx -text
*.docx -text
# Preserve manifest-managed frozen bytes, including CRLF data and scripts.
baselines/** -text
generated/** -text
generated/** linguist-generated=true
references/legacy/** -text
scripts/** -text
verification/** -text
simulink*/** -text
simulation/*.m -text
# ETH01 archives keep generated/tool-output bytes; accept their native CRLF.
generated/ethernet/eth01/** whitespace=cr-at-eol
verification/ethernet/eth01/** whitespace=cr-at-eol
