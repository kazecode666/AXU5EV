# Runtime and generated tool caches
.runtime/
.local/
build/
slprj/
.Xil/
**/slprj/
**/.Xil/
**/ip_user_files/
**/*.cache/
**/*.runs/
**/*.sim/
**/*.hw/
*.slxc
*.asv
*.autosave
*.jou
*.log
*.wdb
*.wlf
*.vcd
*.dcp
*.str

# Only approved small evidence files may be added explicitly.
# Do not blanket-ignore MAT/SLX/PDF: parameters/models/references need inventory.
references/local_only/
experiments/local_only/
.env
.env.*
*.pem
*.key
__pycache__/
.pytest_cache/
.DS_Store
Thumbs.db

# User-supplied ALINX originals: index and summarize; never add the vendor tree.
/资料/

# ADC HDL Coder side products stay local; only the explicit RTL pair is source.
/generated/adc/AXU5EV_ADC_HDL/*
!/generated/adc/AXU5EV_ADC_HDL/Current_Preprocess.sv
!/generated/adc/AXU5EV_ADC_HDL/Numeric_Algorithm.sv

# Encoder HDL Coder side products remain local; retain the two active modules.
/generated/encoder/AXU5EV_Encoder_Angle_HDL/*
!/generated/encoder/AXU5EV_Encoder_Angle_HDL/Encoder_Angle.sv
!/generated/encoder/AXU5EV_Encoder_Angle_HDL/Electric_Angle_Core.sv
/generated/encoder/feedback_c/*
!/generated/encoder/feedback_c/*.c
!/generated/encoder/feedback_c/*.h

/generated/motor_control/AXU5EV_Duty_Adapter_HDL/*
!/generated/motor_control/AXU5EV_Duty_Adapter_HDL/Duty_To_Compare.sv
!/generated/motor_control/AXU5EV_Duty_Adapter_HDL/Duty_Scale_Core.sv
